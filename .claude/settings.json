{
  "autoMemoryEnabled": false,
  "promptSuggestionEnabled": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"$CLAUDE_PROJECT_DIR/tools/jl.py\" resume --hook",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"$CLAUDE_PROJECT_DIR/tools/jl.py\" checkpoint --auto",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
